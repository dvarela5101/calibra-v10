# Copia este archivo como .env.local y completa los valores.
# .env.local (y cualquier otro .env) está en .gitignore: nunca se versiona.
# En desarrollo no lo llenes a mano: `npm run db:env` lo escribe con las llaves del Supabase local.
# La página de inicio arranca sin estas variables; las sesiones y el login las necesitan.

# Supabase del modelo v10 (proyecto nuevo, no el del prototipo).
# Son públicas por diseño: llegan al navegador. Las encuentras en
# Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (sb_secret_...). Nunca con prefijo NEXT_PUBLIC_, nunca en el repo.
# En Vercel se carga en Settings > Environment Variables.
SUPABASE_SECRET_KEY=

# Correo transaccional (HU-006). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
# En producción, la llave de Resend y un remitente de un dominio verificado en Resend
# (por ejemplo: Calibra <hola@tudominio.com>). Sin dominio verificado, Resend solo entrega
# a la cuenta dueña de la llave.
RESEND_API_KEY=
CORREO_REMITENTE=
# Dirección pública del sitio, para los enlaces de los correos (por ejemplo: https://calibra.example).
# En producción es obligatoria; en desarrollo, sin ella se usa http://localhost:3000.
SITIO_URL=

# Correo dedicado a consultas sobre datos personales (HU-008, R-1). Solo servidor. Sale en el aviso de
# privacidad (/privacidad); sin él, el aviso dice que se publicará pronto.
CORREO_DATOS_PERSONALES=

# Procesos programados (HU-065). Solo servidor. Secreto que pg_cron manda en "Authorization: Bearer ..."
# al llamar las rutas de /api/procesos. Al menos 32 caracteres (por ejemplo: openssl rand -hex 32). El
# mismo valor se guarda en la base, en Vault, como calibra_cron_secreto (ver docs/pendientes-dvarela.md).
# Sin él, las rutas de procesos responden 401 y nada se reintenta.
CRON_SECRETO=

# Solo local: API de Mailpit, donde caen los correos del Supabase local. `npm run db:env` la escribe en
# .env.local, y es el proveedor de correo cuando no hay RESEND_API_KEY (solo acepta URLs de esta máquina).
# MAILPIT_URL=http://127.0.0.1:54324
